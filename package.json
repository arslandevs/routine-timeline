{
  "name": "routine-timeline",
  "version": "0.25.2",
  "description": "Plan tasks and routines in Obsidian with Table, Board, Timeline and Calendar views, repeating tasks, time tracking, reminders and sync through a vault file.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "test": "node tests/run.js",
    "lint": "eslint src"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tasks",
    "timeline",
    "routine"
  ],
  "author": "Arsalan",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.24.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^25.0.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.6.2",
    "typescript": "^5.6.0"
  }
}
